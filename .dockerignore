# .dockerignore — keep the Railway build image small
#
# Everything below is either substrate that's not needed at runtime, or
# our own artifacts (design docs, experiments) that shouldn't ship to prod.

# Node / Bun artifacts
node_modules/
bin/
*.log

# Local configs
.env
.env.local
.env.testing
.env.testing.example

# Git
.git/
.gitignore

# Test infrastructure (don't ship tests to prod)
test/
*.test.ts
*.spec.ts
eval/

# Dev scripts not needed in prod
scripts/
# ...except the one bun runs during `bun install`. package.json declares
# "postinstall": "bun run scripts/postinstall.ts" (added by the v0.50.0.0
# upstream sync), so excluding it makes the Docker build fail with
# `Module not found "scripts/postinstall.ts"` before the server ever starts.
# Negation must stay AFTER the `scripts/` rule — later patterns win.
!scripts/postinstall.ts
docker-compose.test.yml
.gitleaks.toml

# Experiments and design docs
experiments/
docs/dent-brain/design-history/
docs/dent-brain/reference/

# Docs gbrain ships — not needed at runtime, but keep a few for reference
# Commented intentionally: llms.txt, llms-full.txt, README.md, AGENTS.md, CLAUDE.md
# can stay in the image for debugging or future CLI self-docs

# Gstack / Cursor / agents configs (these are substrate meta-files)
.agents/
.cursor/
.factory/
.gbrain/
.github/
.hermes/
.kiro/
.openclaw/
.opencode/

# Our Dropbox-only files (if any leaked in)
*.DS_Store

# Build outputs if any exist
dist/
build/
